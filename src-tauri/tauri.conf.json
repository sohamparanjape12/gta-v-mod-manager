{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gta5-mod-manager",
  "version": "0.1.0",
  "identifier": "com.gta5-mod-manager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GTA V Mod Manager",
        "width": 900,
        "height": 550
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": [
      "bin/CodeWalker.Core.dll",
      "bin/CodeWalker.Core.pdb",
      "bin/CodeWalkerCLI.deps.json",
      "bin/CodeWalkerCLI.dll",
      "bin/CodeWalkerCLI.exe",
      "bin/CodeWalkerCLI.pdb",
      "bin/CodeWalkerCLI.runtimeconfig.json",
      "bin/rpf.exe",
      "bin/ShadersGen9Conversion.xml",
      "bin/SharpDX.dll",
      "bin/SharpDX.Mathematics.dll",
      "bin/strings.txt",
      "bin/UnRAR.exe"
    ]
  }
}
